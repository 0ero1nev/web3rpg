ANALYZER_BASE_URL=http://127.0.0.1:3000
ANALYZER_SERVICE_TOKEN=
ANALYZER_TIMEOUT=120

# Optional only for a private hosted Site; separate from the analyzer token.
ANALYZER_SITES_AUTH_TOKEN=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=60
MODEL_RETRIES=2

AGENT_REQUEST_TIMEOUT=150
AGENT_MAX_TOOL_CALLS=1
AGENT_MAX_GRAPH_STEPS=8
LOG_LEVEL=INFO
