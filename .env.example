HELIUS_API_KEY=
# Dedicated server-to-server credential for the internal v1 analyzer route.
# Use the same strong value in agent-service/.env; never expose it to browsers.
ANALYZER_SERVICE_TOKEN=
# Optional. Used server-side for higher CoinGecko historical-price limits.
COINGECKO_API_KEY=
# Set to "pro" only for a CoinGecko Pro key; omit for a Demo key.
COINGECKO_API_PLAN=

# Public wallet-analysis abuse controls. Tune these for the deployed instance;
# defaults are conservative MVP safeguards, not permanent product limits.
ANALYSIS_MAX_BODY_BYTES=1024
ANALYSIS_RATE_LIMIT_MAX=10
ANALYSIS_RATE_LIMIT_WINDOW_MS=60000
ANALYSIS_MAX_COLD_CONCURRENCY=3
ANALYSIS_MAX_COLD_QUEUE=24
ANALYSIS_CACHE_TTL_MS=600000
ANALYSIS_CACHE_MAX_ENTRIES=500

# Optional comma-separated exact browser origins. Same-origin requests and
# non-browser clients work without this.
ANALYSIS_ALLOWED_ORIGINS=

# Enable only when the deployment proxy overwrites this header. Cloudflare
# deployments should use CF-Connecting-IP and leave this off.
ANALYSIS_TRUST_X_FORWARDED_FOR=0
